{
  "manifest_version": 3,
  "name": "IRCTC Tatkal Auto-Booker Pro",
  "version": "2.0",
  "description": "High-speed Tatkal booking with auto-captcha and wallet injection.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.irctc.co.in/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.irctc.co.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Start Auto-Book"
  },
  "icons": {
    "48": "icon.png"
  }
}
